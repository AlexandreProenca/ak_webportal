<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" version="2.5" method="upgrade" group="hikashoppayment">
	<name>HikaShop Mercado Pago payment plugin</name>
	<creationDate>July 2026</creationDate>
	<version>1.0.0</version>
	<author>AK Soluções</author>
	<authorUrl>https://www.aksolucoes.com.br</authorUrl>
	<copyright>(C) 2026 AK Soluções em Tecnologia</copyright>
	<license>http://www.gnu.org/licenses/gpl-3.0.html GNU/GPLv3</license>
	<description>Recebe pagamentos via Mercado Pago (Checkout Pro): Pix, boleto e cartão de crédito. Usa a API atual do Mercado Pago com Access Token e confirmação por webhook.</description>
	<files>
		<filename plugin="mercadopago">mercadopago.php</filename>
		<filename>mercadopago_end.php</filename>
		<filename>index.html</filename>
	</files>
	<params addpath="/components/com_hikashop/params">
		<param name="pluginoptions" type="pluginoptions" default="plugin" label="hikashop" description="HikaShop options" />
	</params>
	<config>
		<fields name="params" addfieldpath="/components/com_hikashop/fields">
			<fieldset name="basic">
				<field id="pluginoptions" name="pluginoptions" type="pluginoptions" label="hikashop" description="HikaShop options" />
			</fieldset>
		</fields>
	</config>
</extension>
